<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageButton
        android:id="@+id/btnAdicionar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_rounded_green"
        android:clickable="true"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSubtract"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageButton
        android:id="@+id/btnSubtract"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_rounded_red"
        android:clickable="true"
        android:src="@drawable/ic_subtract"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnAdicionar"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnQuantity"
        style="@style/Widget.Material3.Button"
        android:layout_width="55dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="3dp"
        android:backgroundTint="#D9D9D9"
        android:fontFamily="@font/poppins_medium"
        android:text="1"
        android:textColor="@color/black"
        android:textFontWeight="500"
        android:textSize="15sp"
        app:cornerRadius="15dp"
        app:iconTint="#FFF3F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSubtract"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewUnityPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$: 1,90"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_medium"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/textViewName"
        app:layout_constraintStart_toEndOf="@id/btnQuantity"
        android:textAlignment="textEnd"
        app:layout_constraintEnd_toStartOf="@id/textViewName" />

    <TextView
        android:id="@+id/textViewName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical|center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/textViewUnityPrice"
        android:text="Tomate"
        android:textSize="25sp"
        android:fontFamily="@font/poppins_medium"
        android:textFontWeight="500"

        />




</androidx.constraintlayout.widget.ConstraintLayout>